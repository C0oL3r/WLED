#define PALETTE_SOLID_WRAP (strip.paletteBlend == 1 || strip.paletteBlend == 3)
uint16_t wipe_once(void) {
  uint8_t segid = strip.getCurrSegmentId();
  if (SEGENV.call == 0) {
    DEBUG_PRINTLN("Call is 0");
    DEBUG_PRINT("Fade preset: ");
    DEBUG_PRINTLN(modInstance->fadePresets[segid]);
    DEBUG_PRINT("SEGID: ");
    DEBUG_PRINTLN(segid);
    SEGENV.step = 0;
    // strip.now = 0;
    modInstance->wipeStartTime[segid] = millis();
  }

  if (SEGENV.step == 1) {
    if (millis() - modInstance->wipeStartTime[segid] >
        modInstance->effectFadeDelay) {
      SEGENV.step = 2;
      // if(modInstance->fadePresets[segid] != 0)
      // {
      //     applyPreset(modInstance->fadePresets[segid]);
      // }
      modInstance->wipeStartTime[segid] = SEGMENT.next_time;
    }
    return FRAMETIME;
  }

  if (SEGENV.step == 2) {
    uint32_t fadeDuration = 500; // Durata fade-in (în ms)
    uint32_t elapsedFade = millis() - modInstance->wipeStartTime[segid];

    if (elapsedFade > fadeDuration) {
      SEGENV.step = 3; // Trecem la final
      return FRAMETIME;
    }

    uint8_t brightness =
        (elapsedFade * 255) / fadeDuration; // Progres de la 0 la 255
    uint32_t fadeColor = color_blend(
        0, SEGCOLOR(1), brightness); // Interpolare între negru și BG color

    SEGMENT.fill(fadeColor);
    return FRAMETIME;
  }

  if (SEGENV.step == 3) {
    return FRAMETIME;
  }

  uint32_t cycleTime = 750 + (255 - SEGMENT.speed) * 150;
  uint32_t elapsed = millis() - modInstance->wipeStartTime[segid];
  unsigned prog = (elapsed * 65535) / cycleTime;

  unsigned ledIndex = (prog * SEGLEN) >> 15;

  uint32_t col0 = SEGMENT.color_from_palette(0, true, PALETTE_SOLID_WRAP, 0);
  for (unsigned i = 0; i < SEGLEN; i++) {
    if (i <= ledIndex) {
      SEGMENT.setPixelColor(i, col0);
    } else
      SEGMENT.setPixelColor(i, 0);
  }

  if (ledIndex >= SEGLEN - 1) {
    DEBUG_PRINTLN(F("Effect done"));
    SEGENV.step = 1;
    modInstance->wipeStartTime[segid] = millis();
    DEBUG_PRINT("OFF DELAY: ");
    DEBUG_PRINTLN(modInstance->effectFadeDelay);
    SEGENV.fill(BLACK);
    // SEGMENT.setColor(0, 0);
    // stateUpdated(CALL_MODE_DIRECT_CHANGE);
    // colorUpdated(CALL_MODE_DIRECT_CHANGE);
  }
  return FRAMETIME;
}
static const char _data_FX_MODE__WIPE_ONCE[] PROGMEM = "Wipe Once@!,!;!,!;!";

void DRL::setup() {
  modInstance = this;
  DEBUG_PRINTLN(F("Setup done"));
  strip.addEffect(255, &wipe_once, _data_FX_MODE__WIPE_ONCE);
}

static DRL DRLUsermod;
REGISTER_USERMOD(DRLUsermod);