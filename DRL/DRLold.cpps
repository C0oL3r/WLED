void DRL::addToConfig(JsonObject &root) {
  JsonObject top = root.createNestedObject(FPSTR(_name));
  top[FPSTR(_enabled)] = enabled;
  // top[FPSTR(_wipeFreezeEnabled)] = wipeFreeze;

  JsonObject effectSettings = top.createNestedObject(F("Effect"));
  effectSettings[FPSTR(_effectFadeDelay)] = effectFadeDelay;

  JsonObject pinsSettings = top.createNestedObject(F("Pins"));
  pinsSettings[FPSTR(_pinStanga)] = pinStanga;
  pinsSettings[FPSTR(_pinDreapta)] = pinDreapta;
  pinsSettings[FPSTR(_pinThreshold)] = pinThreshold;
  // pinsSettings[F("Avarii")] = pinAvarii;
  // pinsSettings[F("Flash")] = PinFlash;
  // JsonObject presetsSettings = top.createNestedObject(F("Presets"));
  // presetsSettings[F("Preset Threshold")] = pinThreshold;
  // presetsSettings[F("Semnal Stanga")] = presetStanga;
  // presetsSettings[F("Semnal Dreapta")] = presetDreapta;
  // presetsSettings[F("Semnal Avarii")] = presetAvarii;
  // presetsSettings[F("OFF Semnal Stanga")] = PresetSSOff;
  // presetsSettings[F("Semnal Dreapta")] = PresetSD;
  // presetsSettings[F("OFF Semnal Dreapta")] = PresetSDOff;
  // presetsSettings[F("Avarii")] = PresetA;
  // presetsSettings[F("OFF Avarii")] = PresetAOff;
  // presetsSettings[F("Release Delay")] = ReleaseDelay;
}

bool DRL::readFromConfig(JsonObject &root) {
  // default settings values could be set here (or below using the 3-argument
  // getJsonValue()) instead of in the class definition or constructor setting
  // them inside readFromConfig() is slightly more robust, handling the rare but
  // plausible use case of single value being missing after boot (e.g. if the
  // cfg.json was manually edited and a value was removed)

  JsonObject top = root[FPSTR(_name)];

  if (top.isNull()) {
    DEBUG_PRINT(FPSTR(_name));
    DEBUG_PRINTLN(F(": No config found. (Using defaults.)"));
  }

  bool configComplete = !top.isNull();
  configComplete &= getJsonValue(top[FPSTR(_enabled)], enabled);
  // configComplete &= getJsonValue(top[FPSTR(_wipeFreezeEnabled)], wipeFreeze);
  // enabled = top[FPSTR(enabled)] || enabled;

  JsonObject effectSettings = top[F("Effect")];
  if (effectSettings.isNull()) {
    DEBUG_PRINT(FPSTR(_name));
    DEBUG_PRINTLN(F(": No effect settings found. (Using defaults.)"));
  }
  configComplete = !effectSettings.isNull();
  configComplete &= getJsonValue(effectSettings[FPSTR(_effectFadeDelay)],
                                 effectFadeDelay, 50);

  JsonObject pinsSettings = top[F("Pins")];
  if (pinsSettings.isNull()) {
    DEBUG_PRINT(FPSTR(_name));
    DEBUG_PRINTLN(F(": No pin configuration found. (Using defaults.)"));
  }

  configComplete = !pinsSettings.isNull();
  // int tmpFlash = -1;
  // int8_t oldPinStanga = pinStanga;
  // int8_t oldPinDreapta = pinDreapta;
  // int8_t oldPinAvarii = pinAvarii;

  configComplete &=
      getJsonValue(pinsSettings[FPSTR(_pinStanga)], pinStanga, -1);
  configComplete &=
      getJsonValue(pinsSettings[FPSTR(_pinDreapta)], pinDreapta, -1);
  configComplete &=
      getJsonValue(pinsSettings[FPSTR(_pinThreshold)], pinThreshold, 10);
  // configComplete &= getJsonValue(pinsSettings[FPSTR(_pinAvarii)], pinAvarii,
  // -1); configComplete &= getJsonValue(pinsSettings[F("Flash")], tmpFlash,
  // -1);

  // JsonObject presetsSettings = top[F("Presets")];
  // if(presetsSettings.isNull())
  // {
  //     DEBUG_PRINT(FPSTR(_name));
  //     DEBUG_PRINTLN(F(": No presets configuration found. (Using
  //     defaults.)")); return false;
  // }

  // configComplete = !presetsSettings.isNull();
  // configComplete &= getJsonValue(presetsSettings[FPSTR(_pinThreshold)],
  // pinThreshold, 10); configComplete &=
  // getJsonValue(presetsSettings[FPSTR(_pinStanga)], presetStanga, 1);
  // // configComplete &= getJsonValue(presetsSettings[F("OFF Semnal Stanga")],
  // PresetSSOff, 1); configComplete &=
  // getJsonValue(presetsSettings[FPSTR(_pinDreapta)], presetDreapta, 1);
  // // configComplete &= getJsonValue(presetsSettings[F("OFF Semnal Dreapta")],
  // PresetSDOff, 1); configComplete &=
  // getJsonValue(presetsSettings[FPSTR(_pinAvarii)], presetAvarii, 1);
  // // configComplete &= getJsonValue(presetsSettings[F("OFF Avarii")],
  // PresetAOff, 1);
  // // configComplete &= getJsonValue(presetsSettings[F("Release Delay")],
  // ReleaseDelay, 1000);

  // if(loaded)
  // {
  //     if (oldPinStanga != pinStanga || oldPinDreapta != pinDreapta ||
  //     oldPinAvarii != pinAvarii)//|| tmpFlash != PinFlash)
  //     {
  //         if (oldPinStanga != -1)
  //             pinManager.deallocatePin(oldPinStanga, PinOwner::UM_DRL);
  //         if (oldPinDreapta != -1)
  //             pinManager.deallocatePin(oldPinDreapta, PinOwner::UM_DRL);
  //         if (oldPinAvarii != -1)
  //             pinManager.deallocatePin(oldPinAvarii, PinOwner::UM_DRL);

  //        allocatePins();
  //     }
  // }
  // else setupData();
  if (configComplete) {
    bStanga = -1;
    bDreapta = -1;
    loaded = true;
  }
  return configComplete;
}

