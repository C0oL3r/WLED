bool buttonActionDone[WLED_MAX_BUTTONS] _INIT({false});

bool DRL::handleButton(uint8_t b) {
  yield();
  if (!enabled || !loaded || buttonType[b] != BTN_TYPE_PUSH)
    return false;

  unsigned int now = millis();
  bool handled = false;

  if (btnPin[b] == pinStanga || btnPin[b] == pinDreapta) {
    if (bStanga == -1 && btnPin[b] == pinStanga)
      bStanga = b;
    if (bDreapta == -1 && btnPin[b] == pinDreapta)
      bDreapta = b;

    if (isButtonPressed(b)) {
      DEBUG_PRINT(F("Button pressed, waiting for threshold. "));
      DEBUG_PRINTLN(now - buttonPressedTime[b]);
      if (!buttonPressedBefore[b]) {
        buttonPressedTime[b] = now;
        buttonActionDone[b] = false;
      }
      buttonPressedBefore[b] = true;

      if (!buttonActionDone[b] && now - buttonPressedTime[b] > pinThreshold) {
        if ((btnPin[b] == pinStanga && buttonPressedBefore[bDreapta]) ||
            (btnPin[b] == pinDreapta && buttonPressedBefore[bStanga])) {
          DEBUG_PRINTLN("Both buttons pressed, AVARII");
        } else {
          DEBUG_PRINTLN("Threshold passed.");
          shortPressAction(b);
          buttonActionDone[b] = true;
          buttonPressedTime[b] = now;
        }
      }
    } else if (buttonPressedBefore[b]) {
      if (now - buttonPressedTime[b] > pinThreshold) {
        DEBUG_PRINTLN("Threshold failed.");
        buttonPressedBefore[b] = false;
      } else if (buttonActionDone[b])
        buttonPressedBefore[b] = false;
    }
    handled = true;
  }

  return handled;
}

bool DRL::handleButtonAAA(
    uint8_t b) // Pentru comparator, intrare separata avarii
{
  yield();
  if (!enabled || !loaded || buttonType[b] != BTN_TYPE_PUSH)
    return false;

  unsigned int now = millis();
  bool handled = false;

  if (btnPin[b] == pinStanga || btnPin[b] == pinDreapta) {
    handled = true;
    if (isButtonPressed(b)) {
      DEBUG_PRINT(F("Button pressed, waiting for threshold. "));
      DEBUG_PRINTLN(now - buttonPressedTime[b]);
      if (!buttonPressedBefore[b]) {
        buttonPressedTime[b] = now;
        buttonActionDone[b] = false;
      }
      buttonPressedBefore[b] = true;

      if (!buttonActionDone[b] && now - buttonPressedTime[b] > pinThreshold) {
        DEBUG_PRINTLN("Threshold passed.");
        shortPressAction(b);
        buttonActionDone[b] = true;
        buttonPressedTime[b] = now;
      }
    } else if (buttonPressedBefore[b]) {
      if (now - buttonPressedTime[b] > pinThreshold) {
        DEBUG_PRINTLN("Threshold failed.");
        buttonPressedBefore[b] = false;
      } else if (buttonActionDone[b])
        buttonPressedBefore[b] = false;
    }
  }
  return handled;
}

void DRL::readFromJsonState(JsonObject &root) {
  memset(modInstance->fadePresets, 0, sizeof(modInstance->fadePresets));
  if (root["fadePreset"]) {
    DEBUG_PRINT("PRESET FOUND IN JSON: ");
    uint8_t preset = root["fadePreset"];
    DEBUG_PRINTLN(preset);

    JsonArray segArray = root["seg"].as<JsonArray>();
    if (!segArray.isNull() && segArray.size() > 0) {
      // Extragem ID-ul primului segment
      int firstSegId = segArray[0]["id"] | 0;
      DEBUG_PRINT("SEGID FOUND: ");
      DEBUG_PRINTLN(firstSegId);
      if (firstSegId != -1)
        modInstance->fadePresets[firstSegId] = preset;
    }
  }
}

void DRL::onStateChange(uint8_t mode) {
  DEBUG_PRINT("Mode: ");
  DEBUG_PRINTLN(mode);
}

